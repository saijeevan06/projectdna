# Supabase project URL and legacy JWT anon key used by the current Edge Function bearer-token wiring.
# Do not put a service_role/secret key or AI provider key in this Vite env file.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional approved official NxtWave workshop URL. If unset, results offer demo capture.
VITE_WORKSHOP_URL=
